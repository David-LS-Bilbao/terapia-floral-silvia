---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import SocialLinks from "../components/SocialLinks.astro";
import WhoAmI from "../components/WhoAmI.astro";
// 🔧 IMPORTAR la imagen desde assets
import silviaImg from "../assets/silvia2.png";

const base = (import.meta as any).env?.BASE_URL || "/";
// 🔧 USAR la imagen importada
const silvia = silviaImg.src;

const whatsapp = "https://wa.me/34687235652?text=Hola%20Silvia%2C%20me%20gustar%C3%ADa%20pedir%20cita%20o%20informaci%C3%B3n.";
const email = "biomiflor@hotmail.com";

// Datos principales
const nombre = "Silvia Adame";
const titulo = "Terapeuta Floral · Mindfulness";
const resumen = "Acompaño procesos emocionales con Flores de Bach, escucha activa y técnicas de atención plena. Sesiones presenciales en Valle de Mena y online.";
const formacion = [
  "Formación en Terapia Floral (Flores de Bach)",
  "Titulada en experto de Mindfulness y Gestión Emocional ",
  "Atención y acompañamiento a personas en procesos de cambio",
];

// Añadido: texto resumen de su enfoque basado en el trabajo del documento
const enfoque = "Mi trabajo integra Mindfulness Terapia con Flores de Bach y gestión emocional y Psicología Positiva para ayudar a las personas a cultivar la atención plena, reconocer sus emociones y transformarlas en recursos de bienestar. A través de la práctica consciente y la comprensión emocional, acompaño procesos personales orientados a recuperar la calma, la claridad y la resiliencia.";

const site = (import.meta as any).env.BASE_URL || "/";
---

<Base 
  title="Contacto | Terapia Floral Silvia Adame - Pide tu Cita" 
  description="Contacta con Silvia Adame para terapia floral, mindfulness o bioneuroemoción. WhatsApp: 687 235 652. Valle de Mena, Bizkaia. Primera consulta gratuita."
  keywords="contacto terapeuta, cita flores bach, consulta mindfulness, valle de mena, bizkaia"
>
  <Nav />
  <main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <!-- Cabecera -->
    <header class="mb-8 md:mb-12">
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Contacto</h1>
      <p class="mt-2 text-neutral-600">Valle de Mena (y online).</p>
    </header>

    <!-- Grid principal -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <!-- CTA de contacto -->
      <section class="rounded-2xl bg-white/70 backdrop-blur shadow-sm ring-1 ring-black/5 p-6 md:p-8">
        <h2 class="text-xl md:text-2xl font-semibold">Pide tu cita o información</h2>

        <!-- 🟢 NUEVO: breve introducción inspirada en su enfoque -->
        <p class="mt-3 text-neutral-700">
          A través del Mindfulness la terapia floral y la gestión emocional ayudo a recuperar la calma, comprender los patrones que nos bloquean
          y transformar la experiencia cotidiana en bienestar. Si deseas más información o reservar una sesión, escríbeme.
        </p>

        <p class="mt-2 text-neutral-600">Te respondo en el mismo día laboral.</p>

        <div class="mt-6 flex flex-col gap-3">
          <a href={whatsapp} target="_blank" rel="noopener"
             class="inline-flex items-center justify-center rounded-xl px-5 py-3 text-base font-medium bg-green-600 text-white hover:bg-green-700 transition">
            WhatsApp
          </a>

          <a href={`mailto:${email}`} class="inline-flex items-center justify-center rounded-xl px-5 py-3 text-base font-medium bg-purple-500 text-white hover:bg-purple-600 transition">
            {email}
          </a>
        </div>

        <p class="mt-3 text-xs text-neutral-500">
          Al contactar aceptas la <a class="underline" href={`${base}legal/privacidad/`}>Política de privacidad</a>.
        </p>

        <div class="mt-6">
          <SocialLinks
            facebook="https://www.facebook.com/silvia.adame.129" 
            instagram="https://www.instagram.com/silviyou8/"
            tiktok="https://www.tiktok.com/@silviaad219?_r=1&_t=ZN-91JC0ig3hME"
            class="text-neutral-800 justify-center gap-8"
            size={32} />
        </div>
      </section>

      <!-- Quién soy + foto  -->
      <WhoAmI
        name={nombre}
        title={titulo}
        summary={resumen}
        bullets={formacion}
        photoSrc={silvia}
        photoAlt="Silvia Adame"
        showTarifasButton={true}
        tarifasLink={base + "tarifas/"} />

      <!-- 🟣 NUEVO BLOQUE: pequeño texto con su enfoque -->
      <div class="md:col-span-2 mt-6 text-neutral-700 bg-white/60 p-6 rounded-2xl shadow-sm ring-1 ring-black/5">
        <h3 class="text-lg font-semibold mb-2">Mi enfoque</h3>
        <p>{enfoque}</p>
        <p class="mt-3">
          <a href={base + "mindfulness-gestion-emocional/"} class="text-purple-600 underline hover:text-purple-700">
            Leer más sobre mi enfoque →
          </a>
        </p>
      </div>
    </div>

    <!-- Botón volver al inicio -->
    <div class="mt-8 text-center">
      <a href={base + "hero-b/"} 
         class="inline-flex items-center justify-center px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors duration-200 font-medium">
        ← Volver al Inicio
      </a>
    </div>

    <!-- SEO Schema -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": nombre,
        "jobTitle": titulo,
        "description": resumen,
        "email": `mailto:${email}`,
        "sameAs": [
          "https://www.facebook.com/silvia.adame.129",
          "https://www.instagram.com/silviyou8/",
          "https://www.tiktok.com/@terapiasnaturales1?_r=1&_t=ZN-91VE9TIAHME"
        ]
      })}
    </script>
  </main>
</Base>