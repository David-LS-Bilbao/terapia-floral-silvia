---
// Redirect automático a hero-b
const base = (import.meta as any).env.BASE_URL || "/";

// Helper para respetar el base path
const withBase = (path: string): string => {
  if (!path) return base;
  return base.endsWith('/') ? base + path : base + '/' + path;
};

// Redirección del lado del servidor
return Astro.redirect(`${base}hero-b/`);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cargando...</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      background: #0B1220;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: system-ui, -apple-system, sans-serif;
    }
    
    .loader-container {
      text-align: center;
      animation: fadeIn 0.3s ease-in;
    }
    
    .logo {
      width: 200px;
      height: 200px;
      margin: 0 auto;
      animation: pulse 2s ease-in-out infinite;
      filter: drop-shadow(0 0 20px rgba(159, 184, 173, 0.3));
    }
    
    .loading-text {
      color: #9FB8AD;
      font-size: 1.2rem;
      margin-top: 2rem;
      opacity: 0.8;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    @keyframes pulse {
      0%, 100% { 
        transform: scale(1);
        opacity: 1;
      }
      50% { 
        transform: scale(1.05);
        opacity: 0.8;
      }
    }
  </style>
</head>
<body>
  <div class="loader-container">
    <img 
      src={withBase("brand/logo-lotus.png")} 
      alt="Terapias Naturales Silvia Adame" 
      class="logo"
    />
    <p class="loading-text">Cargando...</p>
  </div>
  
  <script define:vars={{ base }}>
    // Fallback de redirección del lado del cliente por si acaso
    setTimeout(() => {
      window.location.href = base + 'hero-b/';
    }, 100);
  </script>
</body>
</html>
