---
/**
 * SEO Component - Meta tags mejorados para SEO
 * Incluye Open Graph, Twitter Cards, Schema.org y más
 */

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  keywords?: string;
}

const {
  title = "Terapia Floral Silvia Adame | Flores de Bach, Mindfulness y Bioneuroemoción®",
  description = "Especialista en Terapia Floral de Bach, Mindfulness y Bioneuroemoción® en Valle de Mena, Bizkaia. Consultas presenciales y online. Primera consulta gratuita.",
  image = "/og-image-1200x630.png",
  type = "website",
  canonical,
  noindex = false,
  keywords = "flores de bach, terapia floral, mindfulness, bioneuroemoción, terapias naturales, gestión emocional, bizkaia, valle de mena, terapeuta floral, salud emocional, flores de bach online"
} = Astro.props;

// Helper para respetar el base path en GitHub Pages
const withBase = (path: string): string => {
  const base = import.meta.env.BASE_URL || "/";
  if (!path) return base;
  if (path.startsWith('http')) return path;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return base.endsWith('/') ? base + cleanPath.slice(1) : base + cleanPath;
};

const site = import.meta.env.SITE || 'https://terapias-naturales-silvia.github.io';
const canonicalURL = canonical || new URL(Astro.url.pathname, site).toString();
const imageURL = image.startsWith('http') ? image : new URL(withBase(image), site).toString();

// Schema.org structured data
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Terapia Floral Silvia Adame",
  "description": description,
  "url": site,
  "telephone": "+34687235652",
  "email": "biomiflor@hotmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Valle de Mena",
    "addressRegion": "Bizkaia",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.1121,
    "longitude": -3.2771
  },
  "openingHours": "Mo-Fr 09:00-20:00",
  "priceRange": "€€",
  "image": imageURL,
  "founder": {
    "@type": "Person",
    "name": "Silvia Adame",
    "jobTitle": "Terapeuta Floral Certificada",
    "description": "Especialista en Terapia Floral de Bach, Mindfulness y Bioneuroemoción®",
    "image": imageURL
  },
  "sameAs": [
    "https://www.facebook.com/silvia.adame.129",
    "https://www.instagram.com/silviyou8/",
    "https://www.tiktok.com/@terapiasnaturales1"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "23"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de Terapia",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Sesión Individual de Terapia Floral",
          "description": "Consulta personalizada con selección de esencias florales"
        },
        "price": "58",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Bono 4 Sesiones",
          "description": "Paquete de 4 sesiones de terapia"
        },
        "price": "195",
        "priceCurrency": "EUR"
      }
    ]
  }
};

// Convert schema to JSON string in frontmatter
const schemaJSON = JSON.stringify(schemaOrg);
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="author" content="Silvia Adame">
<meta name="language" content="es">
<meta name="geo.region" content="ES-BI">
<meta name="geo.placename" content="Valle de Mena, Bizkaia">
<meta name="geo.position" content="43.1121;-3.2771">

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="es" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- Robots -->
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:site_name" content="Terapia Floral Silvia Adame" />
<meta property="og:locale" content="es_ES" />
<meta property="og:locale:alternate" content="es_ES" />
<meta property="business:contact_data:street_address" content="Valle de Mena">
<meta property="business:contact_data:locality" content="Valle de Mena">
<meta property="business:contact_data:region" content="Bizkaia">
<meta property="business:contact_data:postal_code" content="48810">
<meta property="business:contact_data:country_name" content="España">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:creator" content="@silviyou8" />
<meta name="twitter:site" content="@silviyou8" />

<!-- Additional SEO tags -->
<meta name="theme-color" content="#0B1220" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Terapia Floral" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="geo.position" content="43.1121;-3.2771" />
<meta name="ICBM" content="43.1121, -3.2771" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={schemaJSON} />
